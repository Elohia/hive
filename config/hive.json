{
  "$schema": "hive-config-v1",
  "version": "0.1.0",
  "home": "D:\\hive",
  "server": {
    "host": "127.0.0.1",
    "port": 8787,
    "token": "",
    "sse": true
  },
  "paths": {
    "db": "data/hive.db",
    "runs": "data/runs",
    "artifacts": "data/artifacts",
    "logs": "data/logs",
    "workspace": "data/work",
    "prompts": "prompts"
  },
  "credentials": {
    "file": "F:\\dsh-home\\.credentials.yaml",
    "keys": {
      "deepseek": "DEEPSEEK_API_KEY",
      "glm": "GO_GLM_API_KEY",
      "qwen": "QWEN_TOKEN_PLAN_API_KEY",
      "agnes": "AGNES_AI_API_KEY",
      "xiaomi": "XIAOMI_API_KEY"
    }
  },
  "llm": {
    "default": "deepseek",
    "providers": {
      "deepseek": {
        "baseURL": "https://api.deepseek.com/v1",
        "keyRef": "deepseek",
        "models": {
          "cheap": "deepseek-chat",
          "strong": "deepseek-reasoner"
        },
        "pricing": {
          "cheap": {
            "in": 2,
            "out": 8
          },
          "strong": {
            "in": 4,
            "out": 16
          }
        }
      },
      "glm": {
        "baseURL": "https://opencode.ai/zen/go/v1",
        "keyRef": "glm",
        "headers": {
          "x-opencode-session": "dsh-opencode-go-session"
        },
        "models": {
          "cheap": "glm-5.3-flash",
          "strong": "glm-5.3-flash"
        },
        "pricing": {
          "cheap": {
            "in": 0.5,
            "out": 2
          },
          "strong": {
            "in": 0.5,
            "out": 2
          }
        }
      },
      "xiaomi": {
        "baseURL": "https://api.xiaomimimo.com/v1",
        "keyRef": "xiaomi",
        "models": {
          "cheap": "mimo-v2.6-flash",
          "strong": "mimo-v2.6-pro"
        },
        "pricing": {
          "cheap": {
            "in": 1,
            "out": 4
          },
          "strong": {
            "in": 4,
            "out": 16
          }
        }
      }
    }
  },
  "executors": {
    "llm": {
      "enabled": true,
      "kind": "inline"
    },
    "dsh": {
      "enabled": true,
      "kind": "process",
      "command": "dsh",
      "args": [
        "--profile",
        "headless"
      ],
      "cwdMode": "task",
      "coldStartSec": 55,
      "note": "dsh --profile headless \"<job>\" prints final answer and exits"
    },
    "pi": {
      "enabled": true,
      "kind": "process",
      "command": "pi",
      "args": [
        "-p",
        "--mode",
        "json"
      ],
      "cwdMode": "task"
    },
    "codex": {
      "enabled": true,
      "kind": "process",
      "command": "codex",
      "args": [
        "exec",
        "--skip-git-repo-check"
      ],
      "cwdMode": "task",
      "note": "已改指向 Xiaomi Token Plan CN（https://token-plan-cn.xiaomimimo.com） 的 OpenAI 兼容端点（~/.codex/config.toml: base_url=https://token-plan-cn.xiaomimimo.com/v1, wire_api=responses, model=mimo-v2.6-pro）。实测 codex exec 通过。"
    },
    "claude": {
      "enabled": true,
      "kind": "process",
      "command": "claude",
      "args": [
        "-p"
      ],
      "cwdMode": "task",
      "note": "已改指向 Xiaomi Token Plan CN（https://token-plan-cn.xiaomimimo.com） 的 Anthropic 兼容端点（~/.claude/settings.json: ANTHROPIC_BASE_URL=https://token-plan-cn.xiaomimimo.com/anthropic, model=mimo-v2.6-pro）。实测 claude -p 通过。"
    },
    "shell": {
      "enabled": true,
      "kind": "process",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-Command"
      ],
      "cwdMode": "task"
    },
    "proc": {
      "enabled": true,
      "kind": "process",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-Command"
      ],
      "note": "通用命令执行器：任务体里给出 command 就用它跑。自然语言任务不会被路由到这里（TASK_EXECUTORS 白名单），需要显式命令时用。"
    },
    "grok": {
      "enabled": true,
      "kind": "http",
      "bridgeUrl": "http://127.0.0.1:8799",
      "chat": "",
      "timeoutMs": 180000,
      "note": "Grok Bot 执行器：经本地消息桥派单给它的人格会话（趋势分析师/数据分析师/A股调用…）。chat 留空=用桥当前会话；它会真的在桌面会话里打字，属于对外副作用，只用于研究/分析/起草。"
    }
  },
  "settings": {
    "tickSec": 20,
    "pulseGraceSec": 90,
    "maxConcurrentWorkers": 2,
    "defaultTimeoutSec": 900,
    "defaultBudgetTokens": 120000,
    "maxAttempts": 3,
    "retryBackoffSec": [
      60,
      300,
      900
    ],
    "dailyBudgetCny": 8,
    "budgetWarnRatio": 0.8,
    "quietThreshold": 6,
    "dupTitleWindowHours": 24,
    "maxNotifyPerDay": 12,
    "approvalTtlHours": 72,
    "itemRetentionDays": 90,
    "lanes": {
      "L1": 3,
      "L2": 2,
      "L3": 2,
      "L4": 1,
      "L5": 1
    },
    "pulseTimeoutSec": 240,
    "quietAction": "archive",
    "reap": {
      "enabled": true,
      "inboxTtlDays": 3,
      "inboxMax": 60,
      "foldDuplicates": true,
      "staleInfoDays": 1
    }
  },
  "notify": {
    "toast": {
      "enabled": true
    },
    "mail": {
      "enabled": false,
      "command": "agently-cli",
      "to": "",
      "note": "需人工批准后才发；启用前先填 to"
    },
    "dashboard": {
      "enabled": true
    }
  },
  "sources": {
    "mail": {
      "enabled": true,
      "intervalSec": 900,
      "command": "agently-cli",
      "limit": 12,
      "dir": "inbox",
      "unreadOnly": true,
      "maxBodyChars": 2500
    },
    "git": {
      "enabled": true,
      "intervalSec": 1800,
      "repos": [
        "D:\\hive",
        "D:\\elohia",
        "D:\\pi-agent",
        "D:\\evo",
        "D:\\00-fish",
        "D:\\001-blander"
      ],
      "lookbackHours": 48
    },
    "docs": {
      "enabled": true,
      "intervalSec": 3600,
      "roots": [
        "D:\\elohia\\reports",
        "D:\\pi-agent\\reports",
        "D:\\hive\\docs",
        "D:\\elohia\\docs"
      ],
      "lookbackHours": 72,
      "exts": [
        ".md",
        ".txt",
        ".html",
        ".json"
      ],
      "snippetChars": 2000
    },
    "calendar": {
      "enabled": true,
      "intervalSec": 3600,
      "icsPaths": [
        "data\\calendar\\*.ics"
      ],
      "lookaheadHours": 72
    },
    "x": {
      "enabled": false,
      "intervalSec": 3600,
      "note": "依赖 DSH x_* 工具，daemon 侧暂以 CLI 方式接入"
    },
    "wechat": {
      "enabled": false,
      "intervalSec": 1800,
      "note": "依赖 D:\\elohia 的 wcdb 桥；默认关闭（隐私）"
    },
    "pulses_local": {
      "enabled": true,
      "intervalSec": 1800,
      "note": "读取本机既有自动化产物（pi-agent automations / dsh-home duties）作为进展信号"
    },
    "self": {
      "enabled": true,
      "intervalSec": 3600,
      "note": "自检：失败任务堆积/预算/数据库健康"
    }
  }
}