{
  "$schema": "hive-config-v1",
  "version": "0.1.0",
  "home": "",
  "server": {
    "host": "127.0.0.1",
    "port": 8787,
    "token": "",
    "sse": true
  },
  "paths": {
    "db": "data/hive.db",
    "runs": "data/runs",
    "artifacts": "data/artifacts",
    "logs": "data/logs",
    "workspace": "data/work",
    "prompts": "prompts"
  },
  "credentials": {
    "file": "",
    "keys": {}
  },
  "llm": {
    "default": "deepseek",
    "providers": {
      "deepseek": {
        "baseURL": "https://api.deepseek.com/v1",
        "keyRef": "deepseek",
        "models": {
          "cheap": "deepseek-chat",
          "strong": "deepseek-reasoner"
        },
        "pricing": {
          "cheap": {
            "in": 2,
            "out": 8
          },
          "strong": {
            "in": 4,
            "out": 16
          }
        }
      },
      "glm": {
        "baseURL": "https://opencode.ai/zen/go/v1",
        "keyRef": "glm",
        "headers": {
          "x-opencode-session": "dsh-opencode-go-session"
        },
        "models": {
          "cheap": "glm-5.3-flash",
          "strong": "glm-5.3-flash"
        },
        "pricing": {
          "cheap": {
            "in": 0.5,
            "out": 2
          },
          "strong": {
            "in": 0.5,
            "out": 2
          }
        }
      },
      "xiaomi": {
        "baseURL": "https://api.xiaomimimo.com/v1",
        "keyRef": "xiaomi",
        "models": {
          "cheap": "mimo-v2.6-flash",
          "strong": "mimo-v2.6-pro"
        },
        "pricing": {
          "cheap": {
            "in": 1,
            "out": 4
          },
          "strong": {
            "in": 4,
            "out": 16
          }
        }
      }
    }
  },
  "executors": {
    "llm": {
      "enabled": true,
      "kind": "inline"
    },
    "dsh": {
      "enabled": true,
      "kind": "process",
      "command": "dsh",
      "args": [
        "--profile",
        "headless"
      ],
      "cwdMode": "task",
      "coldStartSec": 55,
      "note": "dsh --profile headless \"<job>\" prints final answer and exits"
    },
    "pi": {
      "enabled": true,
      "kind": "process",
      "command": "pi",
      "args": [
        "-p",
        "--mode",
        "json"
      ],
      "cwdMode": "task"
    },
    "codex": {
      "enabled": true,
      "kind": "process",
      "command": "codex",
      "args": [
        "exec",
        "--skip-git-repo-check"
      ],
      "cwdMode": "task"
    },
    "claude": {
      "enabled": true,
      "kind": "process",
      "command": "claude",
      "args": [
        "-p"
      ],
      "cwdMode": "task"
    },
    "shell": {
      "enabled": true,
      "kind": "process",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-Command"
      ],
      "cwdMode": "task"
    }
  },
  "settings": {
    "tickSec": 20,
    "pulseGraceSec": 90,
    "maxConcurrentWorkers": 2,
    "defaultTimeoutSec": 900,
    "defaultBudgetTokens": 120000,
    "maxAttempts": 3,
    "retryBackoffSec": [
      60,
      300,
      900
    ],
    "dailyBudgetCny": 8,
    "budgetWarnRatio": 0.8,
    "quietThreshold": 6,
    "dupTitleWindowHours": 24,
    "maxNotifyPerDay": 12,
    "approvalTtlHours": 72,
    "itemRetentionDays": 90,
    "lanes": {
      "L1": 3,
      "L2": 2,
      "L3": 2,
      "L4": 1,
      "L5": 1
    },
    "pulseTimeoutSec": 240
  },
  "notify": {
    "toast": {
      "enabled": true
    },
    "mail": {
      "enabled": false,
      "command": "agently-cli",
      "to": "",
      "note": "需人工批准后才发；启用前先填 to"
    },
    "dashboard": {
      "enabled": true
    }
  },
  "sources": {
    "mail": {
      "enabled": false,
      "intervalSec": 900,
      "command": "agently-cli",
      "limit": 12,
      "dir": "inbox",
      "unreadOnly": true,
      "maxBodyChars": 2500
    },
    "git": {
      "enabled": true,
      "intervalSec": 1800,
      "repos": [],
      "lookbackHours": 48
    },
    "docs": {
      "enabled": true,
      "intervalSec": 3600,
      "roots": [],
      "lookbackHours": 72,
      "exts": [
        ".md",
        ".txt",
        ".html",
        ".json"
      ]
    },
    "calendar": {
      "enabled": true,
      "intervalSec": 3600,
      "icsPaths": [
        "data/calendar/*.ics"
      ],
      "lookaheadHours": 72
    },
    "x": {
      "enabled": false,
      "intervalSec": 3600,
      "note": "依赖 DSH x_* 工具，daemon 侧暂以 CLI 方式接入"
    },
    "wechat": {
      "enabled": false,
      "intervalSec": 1800,
      "note": "依赖 C:/HIVE-SAMPLE/workspace 的 wcdb 桥；默认关闭（隐私）"
    },
    "pulses_local": {
      "enabled": true,
      "intervalSec": 1800,
      "note": "读取本机既有自动化产物（pi-agent automations / dsh-home duties）作为进展信号"
    },
    "self": {
      "enabled": true,
      "intervalSec": 3600,
      "note": "自检：失败任务堆积/预算/数据库健康"
    }
  }
}